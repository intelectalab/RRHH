# QA-17 · Entrada HTTPS única (puertos 80 y 443). Certificados automáticos de Let's Encrypt:
#  - {$BASE_DOMAIN}            → sitio comercial (site:3001)
#  - www.{$BASE_DOMAIN}        → redirige al dominio base
#  - api.{$BASE_DOMAIN}        → API (api:8000), para integraciones y la app móvil
#  - cualquier otro host       → aplicación (web:3000): consola admin.{$BASE_DOMAIN}, cada organización
#                                <slug>.{$BASE_DOMAIN} y los dominios propios verificados. El certificado se
#                                pide la primera vez que alguien entra, solo si la API lo autoriza.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/api/internal/tls/allowed
	}
	servers {
		trusted_proxies static private_ranges
	}
}

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	# Rutas internas (consulta de certificados): nunca desde Internet.
	@interna path /internal/* /api/internal/*
	respond @interna 404
	request_body {
		max_size 30MB
	}
	log {
		output stdout
		format json
	}
}

{$BASE_DOMAIN} {
	import comun
	reverse_proxy site:3001
}

www.{$BASE_DOMAIN} {
	redir https://{$BASE_DOMAIN}{uri} permanent
}

api.{$BASE_DOMAIN} {
	import comun
	reverse_proxy api:8000
}

https:// {
	tls {
		on_demand
	}
	import comun
	reverse_proxy web:3000
}
