# GestiaHR · variables de entorno de desarrollo local (se copia a apps/api/.env en PLT-1)
# Valores solo para la máquina del programador. En otros entornos vienen del gestor de secretos (PLT-9).

APP_NAME=GestiaHR
APP_ENV=local
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=UTC                  # en base todo va en UTC; se muestra en la zona horaria de la empresa

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestiahr
DB_USERNAME=gestia_owner          # migraciones; la aplicación se conecta con un rol que hereda de gestia_app (TEN-2)
DB_PASSWORD=gestia_local

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.gestiahr.test     # cookie HttpOnly compartida entre la web y la API (ADR 0006)

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=gestia
AWS_SECRET_ACCESS_KEY=gestia_local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=gestiahr-local
AWS_ENDPOINT=http://127.0.0.1:8333   # SeaweedFS de docker-compose.yml
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-responder@gestiahr.test
MAIL_FROM_NAME=GestiaHR

# Adaptadores externos: en local y en pruebas siempre el falso (regla 8 de CLAUDE.md)
GESTIA_ADAPTERS=fake
