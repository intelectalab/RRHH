# QA-17 · Variables del ambiente de prueba en el VPS. Copiar a .env (nunca se sube al repositorio) y completar.
# Generar claves:   openssl rand -base64 32   (APP_KEY lleva el prefijo base64:)
# GUARDA APP_KEY EN UN LUGAR SEGURO: sin ella no se pueden leer los datos cifrados (sueldos, documentos…).

APP_ENV=staging
SITE_ENV=staging
# Dominio base: el sitio queda en https://staging.gestiahr.com, la consola en https://admin.staging.gestiahr.com
# y cada organización en https://<subdominio>.staging.gestiahr.com (la demo: https://demo.staging.gestiahr.com).
BASE_DOMAIN=staging.gestiahr.com
# Modo del servidor:
#  - Servidor dedicado: deja COMPOSE_PROFILES=caddy (Caddy toma 80/443 y emite los certificados) y pon ACME_EMAIL.
#  - Servidor que ya tiene Nginx con otros sitios: borra la línea COMPOSE_PROFILES; el Nginx del servidor reparte
#    a estos puertos locales (docker/prod/nginx-gestiahr.conf) y emite los certificados con certbot.
COMPOSE_PROFILES=caddy
ACME_EMAIL=
WEB_PORT=3410
SITE_PORT=3411
API_PORT=8410

APP_KEY=
DB_DATABASE=gestiahr
DB_USERNAME=gestiahr
DB_PASSWORD=
REDIS_PASSWORD=

# Correo saliente por tu SMTP (invitaciones, códigos, boletas, avisos).
MAIL_HOST=
MAIL_PORT=587
# tls (puerto 587) o ssl (puerto 465)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GestiaHR

# Solo para sembrar la organización demo (SEED_DEMO=1 scripts/deploy.sh) y crear el admin de la consola.
# Bórralas del archivo después de usarlas.
DEMO_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD=

# Copias de seguridad (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
